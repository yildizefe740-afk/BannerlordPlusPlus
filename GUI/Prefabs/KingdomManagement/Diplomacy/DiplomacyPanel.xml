<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@Show">
      <Children>
        <BrushListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Frame1Brush" StackLayout.LayoutMethod="VerticalTopToBottom" MarginLeft="4" MarginRight="4" MarginTop="6" MarginBottom="8">
          <Children>
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Kingdom.PoliciesCollapserTitle.Text" Text="Diplomacy" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="190" SuggestedHeight="42" Brush="Kingdom.Policy.Toggle.Tuple" IsVisible="@IsTreatyListVisible" Command.Click="ExecuteOpenProposal">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="Propose Pact" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="190" SuggestedHeight="42" Brush="Kingdom.Policy.Toggle.Tuple" IsVisible="@IsProposalMode" Command.Click="ExecuteCloseProposal">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="Back to Agreements" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>

            <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" AutoHideScrollBars="true" ClipRect="DiplomacyClipRect" InnerPanel="DiplomacyClipRect\DiplomacyContent" VerticalScrollbar="..\DiplomacyScrollbar">
              <Children>
                <Widget Id="DiplomacyClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                  <Children>
                    <ListPanel Id="DiplomacyContent" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <NavigatableListPanel DataSource="{TreatyCategories}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@IsTreatyListVisible" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="5" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" Brush="Kingdom.Policy.Toggle.Tuple" Command.Click="ExecuteToggleExpand">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="@CategoryTitle" />
                                  </Children>
                                </ButtonWidget>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@IsExpanded">
                                  <Children>
                                    <ListPanel DataSource="{Items}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@HasItems" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <ItemTemplate>
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42">
                                          <Children>
                                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Kingdom.Policy.Toggle.Tuple" IsVisible="@IsSubject" Command.Click="ExecuteSelectSubject">
                                              <Children>
                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                                  <Children>
                                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="@KingdomName" />
                                                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="250" Brush="Party.Text.Toggle" Text="@DetailsText" />
                                                  </Children>
                                                </ListPanel>
                                              </Children>
                                            </ButtonWidget>
                                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsRegularItem" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                              <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="@KingdomName" />
                                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="250" Brush="Party.Text.Toggle" Text="@DetailsText" />
                                              </Children>
                                            </ListPanel>
                                          </Children>
                                        </ListPanel>
                                      </ItemTemplate>
                                    </ListPanel>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" Brush="Party.Text.Toggle" IsVisible="@IsEmpty" Text="@EmptyMessage" />
                                    <ListPanel DataSource="{Subcategories}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@HasSubcategories" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <ItemTemplate>
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="24" MarginBottom="4" StackLayout.LayoutMethod="VerticalTopToBottom">
                                          <Children>
                                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" Brush="Kingdom.Policy.Toggle.Tuple" Command.Click="ExecuteToggleExpand">
                                              <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="@CategoryTitle" />
                                              </Children>
                                            </ButtonWidget>
                                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@IsExpanded">
                                              <Children>
                                                <ListPanel DataSource="{Items}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@HasItems" StackLayout.LayoutMethod="VerticalTopToBottom">
                                                  <ItemTemplate>
                                                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                                      <Children>
                                                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Kingdom.Policy.Toggle.Tuple" IsVisible="@IsSubject" Command.Click="ExecuteSelectSubject">
                                                          <Children>
                                                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                                              <Children>
                                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="@KingdomName" />
                                                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="250" Brush="Party.Text.Toggle" Text="@DetailsText" />
                                                              </Children>
                                                            </ListPanel>
                                                          </Children>
                                                        </ButtonWidget>
                                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsRegularItem" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                                          <Children>
                                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="@KingdomName" />
                                                            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="250" Brush="Party.Text.Toggle" Text="@DetailsText" />
                                                          </Children>
                                                        </ListPanel>
                                                      </Children>
                                                    </ListPanel>
                                                  </ItemTemplate>
                                                </ListPanel>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" Brush="Party.Text.Toggle" IsVisible="@IsEmpty" Text="@EmptyMessage" />
                                              </Children>
                                            </Widget>
                                          </Children>
                                        </ListPanel>
                                      </ItemTemplate>
                                    </ListPanel>
                                  </Children>
                                </Widget>
                              </Children>
                            </ListPanel>
                          </ItemTemplate>
                        </NavigatableListPanel>

                        <BrushListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Frame1Brush" IsVisible="@IsSelectedSubjectPanelVisible" MarginTop="12" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" Brush="Kingdom.PoliciesCollapserTitle.Text" Text="@SelectedSubjectName" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" Brush="Party.Text.Toggle" Text="@SelectedSubjectType" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="38" Brush="Kingdom.PoliciesCollapserTitle.Text" IsVisible="@IsSelectedSubjectLibertyDesireVisible" Text="@SelectedSubjectLibertyDesire" />
                          </Children>
                        </BrushListPanel>

                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" IsVisible="@IsProposalMode" MarginLeft="12" MarginRight="12" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" Brush="Kingdom.PoliciesCollapserTitle.Text" Text="Choose an agreement" />
                            <ListPanel DataSource="{ProposalTypes}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48" Brush="Kingdom.Policy.Toggle.Tuple" IsSelected="@IsSelected" Command.Click="ExecuteSelect">
                                  <Children>
                                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <Children>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" Brush="Party.Text.Toggle" Text="@Name" />
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Brush="Party.Text.Toggle" Text="@Description" />
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" Brush="Kingdom.PoliciesCollapserTitle.Text" Text="@SelectedKingdomText" />
                            <ListPanel DataSource="{ProposalTargets}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" Brush="Kingdom.Policy.Toggle.Tuple" IsSelected="@IsSelected" Command.Click="ExecuteSelect">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="@KingdomName" />
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Party.Text.Toggle" Text="@StatusMessage" />
                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48" Brush="Kingdom.Policy.Toggle.Tuple" IsEnabled="@CanSubmitProposal" Command.Click="ExecuteSubmitProposal">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Party.Text.Toggle" Text="Propose Agreement" />
                              </Children>
                            </ButtonWidget>
                          </Children>
                        </ListPanel>
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>
                <ScrollbarWidget Id="DiplomacyScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" VerticalAlignment="Center" AlignmentAxis="Vertical" Handle="DiplomacyScrollbarHandle" MaxValue="100" MinValue="0">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" AlphaFactor="0.2" Color="#472203FF" />
                    <ImageWidget Id="DiplomacyScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="6" SuggestedHeight="10" HorizontalAlignment="Center" Brush="Kingdom.Wars.Scrollbar.Handle" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </ScrollablePanel>
          </Children>
        </BrushListPanel>
      </Children>
    </Widget>
  </Window>
</Prefab>
